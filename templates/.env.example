# ═══════════════════════════════════════════════════════════════════════
# .env.example — Vorlage für Umgebungsvariablen
#
# ANLEITUNG:
#   1. Diese Datei kopieren: cp .env.example .env
#   2. .env mit echten Werten füllen
#   3. .env NIEMALS committen (ist in .gitignore)
#   4. Für Produktion: Secrets Manager verwenden (AWS/Azure/Vault)
#
# ⚠️  DIESE DATEI ENTHÄLT KEINE ECHTEN KEYS — NUR PLATZHALTER
# ═══════════════════════════════════════════════════════════════════════

# ── OpenAI API-Keys (separater Key pro Agent!) ──────────────────────
# Einen Key pro Agent/Umgebung erstellen auf: platform.openai.com/api-keys
OPENAI_KEY_EMAIL_AGENT=sk-proj-ERSETZE-MICH
OPENAI_KEY_SUPPORT_CHAT=sk-proj-ERSETZE-MICH
OPENAI_KEY_DOC_ANALYZER=sk-proj-ERSETZE-MICH
OPENAI_ORG_ID=org-ERSETZE-MICH

# ── Anthropic (Claude) ───────────────────────────────────────────────
ANTHROPIC_KEY_EMAIL_AGENT=sk-ant-api03-ERSETZE-MICH
ANTHROPIC_KEY_SUPPORT=sk-ant-api03-ERSETZE-MICH

# ── Datenbank ────────────────────────────────────────────────────────
# Niemals Produktionsdatenbank in Entwicklungsumgebung verwenden!
DATABASE_URL=postgresql://user:password@localhost:5432/ki_agents_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Anwendungs-Konfiguration ─────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=DEBUG                    # DEBUG nur in Entwicklung!
SECRET_KEY=ersetze-mit-zufaelligem-key-min-32-zeichen

# ── Sicherheits-Konfiguration ────────────────────────────────────────
MAX_INPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=1024
RATE_LIMIT_PER_MINUTE=20
DAILY_BUDGET_USD=10.0              # In Entwicklung niedrig halten!

# Erlaubte Empfänger-Domains (kommagetrennt)
ALLOWED_EMAIL_DOMAINS=firma.com,firma-partner.com

# ── Monitoring & Alerting ────────────────────────────────────────────
# Slack Webhook für Security-Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/ERSETZE/MICH/HIER

# PagerDuty für Critical Alerts (optional)
PAGERDUTY_INTEGRATION_KEY=ERSETZE-MICH

# ── Secrets Manager (Produktion) ────────────────────────────────────
# In Produktion diese Keys verwenden statt direkte API-Keys:
# AWS_REGION=eu-central-1
# AWS_SECRET_NAME_OPENAI=prod/ki-agents/openai-keys
# AZURE_KEYVAULT_URL=https://firma-vault.vault.azure.net/
# VAULT_ADDR=https://vault.firma.com
# VAULT_TOKEN=ERSETZE-MICH

# ── E-Mail-Server (für Benachrichtigungen) ───────────────────────────
SMTP_HOST=smtp.firma.com
SMTP_PORT=587
SMTP_USER=ki-agent@firma.com
SMTP_PASSWORD=ERSETZE-MICH
SMTP_USE_TLS=true

# ── Redis (für Rate-Limiting) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
